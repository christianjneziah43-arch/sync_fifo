`timescale 1ns / 1ps

module tb_fifo_s;

    // Parameters matching the UUT
    parameter DATA_WIDTH = 8;
    parameter DEPTH = 16;

    // Inputs
    reg clk;
    reg rst_n;
    reg wr_en;
    reg rd_en;
    reg [DATA_WIDTH-1:0] data_in;

    // Outputs
    wire [DATA_WIDTH-1:0] data_out;
    wire full;
    wire empty;
    wire almost_full;
    wire almost_empty;

    // Instantiate the Unit Under Test (UUT)
    sync_fifo #(
        .DATA_WIDTH(DATA_WIDTH),
        .DEPTH(DEPTH)
    ) uut (
        .clk(clk),
        .rst_n(rst_n),
        .wr_en(wr_en),
        .rd_en(rd_en),
        .data_in(data_in),
        .data_out(data_out),
        .full(full),
        .empty(empty),
        .almost_full(almost_full),
        .almost_empty(almost_empty)
    );

    // Clock generation (10 ns period / 100 MHz)
    always #5 clk = ~clk;

    integer i;

    initial begin
        // Initialize Inputs
        clk = 0;
        rst_n = 0;
        wr_en = 0;
        rd_en = 0;
        data_in = 0;

        // 1. Reset Test
        #20;
        rst_n = 1;
        #10;

        // 2. Normal Operation - Write condition
        wr_en = 1;
        for (i = 1; i <= 3; i = i + 1) begin
            data_in = i * 10; // Writes 10, 20, 30
            #10;
        end
        wr_en = 0;
        #20;

        // 3. Normal Operation - Read condition
        rd_en = 1;
        #30; // Reads the 3 values back out
        rd_en = 0;
        #20;

        // 4. Boundary & Error Conditions - Fill to max and Overflow
        wr_en = 1;
        for (i = 1; i <= DEPTH + 2; i = i + 1) begin
            data_in = i;
            #10;
        end
        wr_en = 0;
        #20;

        // 5. Boundary & Error Conditions - Empty to zero and Underflow
        rd_en = 1;
        for (i = 1; i <= DEPTH + 2; i = i + 1) begin
            #10;
        end
        rd_en = 0;
        #20;

        // 6. Corner Case - Simultaneous Read and Write
        wr_en = 1; data_in = 8'hAA; #10;
        wr_en = 1; rd_en = 1; data_in = 8'hBB; #10;
        wr_en = 1; rd_en = 1; data_in = 8'hCC; #10;
        wr_en = 0; rd_en = 0;
        #50;

        $finish;
    end

endmodule
