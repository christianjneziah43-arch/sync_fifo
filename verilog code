`timescale 1ns / 1ps

module sync_fifo #(
    parameter DATA_WIDTH = 8,  // Width of each data word
    parameter DEPTH = 16       // Number of data words the FIFO can hold
)(
    input wire clk,
    input wire rst_n,
    input wire wr_en,
    input wire rd_en,
    input wire [DATA_WIDTH-1:0] data_in,
    
    output reg [DATA_WIDTH-1:0] data_out,
    output wire full,
    output wire empty,
    output wire almost_full,
    output wire almost_empty
);

    // Calculate the number of bits needed for the address pointers
    localparam ADDR_WIDTH = $clog2(DEPTH);

    // Memory array for the FIFO
    reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];

    // Pointers and element counter
    reg [ADDR_WIDTH-1:0] wr_ptr;
    reg [ADDR_WIDTH-1:0] rd_ptr;
    reg [ADDR_WIDTH:0]   count; // Needs one extra bit to represent exactly DEPTH

    // Flag logic (Combinational)
    assign empty = (count == 0);
    assign full = (count == DEPTH);
    assign almost_empty = (count == 1);
    assign almost_full  = (count == DEPTH - 1);

    // FIFO Control Logic (Sequential)
    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            wr_ptr <= 0;
            rd_ptr <= 0;
            count  <= 0;
            data_out <= 0;
        end else begin
            // Write operation
            if (wr_en && !full) begin
                mem[wr_ptr] <= data_in;
                wr_ptr <= (wr_ptr == DEPTH - 1) ? 0 : wr_ptr + 1;
            end

            // Read operation
            if (rd_en && !empty) begin
                data_out <= mem[rd_ptr];
                rd_ptr <= (rd_ptr == DEPTH - 1) ? 0 : rd_ptr + 1;
            end

            // Count management
            case ({wr_en && !full, rd_en && !empty})
                2'b10: count <= count + 1; // Write only
                2'b01: count <= count - 1; // Read only
                default: count <= count; 
            endcase
        end
    end
endmodule
